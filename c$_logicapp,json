  // Program.cs
var builder = WebApplication.CreateBuilder(args);
builder.Services.AddHttpClient();
builder.Services.AddSingleton<GraphHelper>(); // handles SharePoint logic

var app = builder.Build();

app.MapPost("/queue-email", async (
    HttpRequest request,
    GraphHelper graphHelper,
    HttpContext context) =>
{
    if (!request.Headers.TryGetValue("x-api-key", out var apiKey) ||
        apiKey != builder.Configuration["ApiKey"])
    {
        return Results.StatusCode(403);
    }

    var payload = await request.ReadFromJsonAsync<EmailPayload>();
    if (payload == null) return Results.BadRequest();

    var result = await graphHelper.AddListItemAsync(payload);
    return result ? Results.Ok("Queued") : Results.StatusCode(500);
});

app.Run();

record EmailPayload(string Title, string To, string Body, string SourceApp);


