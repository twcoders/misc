public init(context: ComponentFramework.Context<IInputs>, notifyOutputChanged: () => void, container: HTMLDivElement): void {
    // Create a textarea element for the editor to bind to
    const textArea = document.createElement("textarea");
    textArea.id = "pcf-tinymce-editor";
    container.appendChild(textArea);

    // Initialize the self-hosted editor
    (window as any).tinymce.init({
        selector: '#pcf-tinymce-editor',
        
        // CRITICAL FOR SELF-HOSTING: Tell TinyMCE where the sub-folders live
        base_url: '/WebResources/your_publisher_prefix_/tinymce', 
        suffix: '.min',
        
        // Define your layout configuration
        plugins: 'lists link table code', 
        toolbar: 'undo redo | styles | bold italic | alignleft aligncenter alignright | lists table',
        
        setup: (editor: any) => {
            editor.on('change', () => {
                const content = editor.getContent();
                // Pass content back to Power Apps field here
            });
        }
    });
}
